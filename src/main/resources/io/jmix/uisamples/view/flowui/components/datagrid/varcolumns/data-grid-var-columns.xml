<view xmlns="http://jmix.io/schema/flowui/view">
    <layout>
        <!-- tag::programmatic-columns[] sample-hide -->
        <hbox>
            <integerField id="columnCountField" placeholder="Number of columns" value="3">
                <validators>
                    <max value="10"/>
                    <min value="1"/>
                </validators>
            </integerField>
            <button id="createDataGridBtn" text="Create DataGrid"/>
        </hbox>
        <vbox id="box" padding="false"/>
        <!-- end::programmatic-columns[] sample-hide -->
    </layout>
</view>
