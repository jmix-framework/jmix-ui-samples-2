<view xmlns="http://jmix.io/schema/flowui/view">
    <layout>
        <!-- tag::orientation[] sample-hide -->
        <checkbox id="orientationCheckbox" label="Vertical"/>
        <tabs id="tabs" width="100%">
            <tab id="profileTab">
                <icon icon="USER"/>
                <span text="Profile"/>
            </tab>
            <tab id="notificationsTab">
                <icon icon="BELL"/>
                <span text="Notifications"/>
            </tab>
            <tab id="settingsTab">
                <icon icon="COG"/>
                <span text="Settings"/>
            </tab>
        </tabs>
        <!-- end::orientation[] sample-hide -->
    </layout>
</view>
