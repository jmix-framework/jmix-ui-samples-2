<view xmlns="http://jmix.io/schema/flowui/view">
    <!-- tag::data[] sample-hide -->
    <data>
        <instance id="taskDc"
                  class="io.jmix.uisamples.entity.Task"
                  fetchPlan="_local"/>
    </data>
    <!-- end::data[] sample-hide -->
    <layout>
        <!-- tag::data-binding[] sample-hide -->
        <timePicker id="timePicker" label="TimePicker"
                         dataContainer="taskDc" property="dueDate"/>
        <!-- end::data-binding[] sample-hide -->
        <hbox>
            <span text="Value in the container:"/>
            <span id="spanValue"/>
        </hbox>
    </layout>
</view>
